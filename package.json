{
	"name": "tmdb-sveltekit-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"lint": "npm run format:check && npm run lint:eslint",
		"format": "prettier --write ./src",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"format:check": "prettier --check ./src",
		"lint:eslint": "eslint ./src",
		"lint:fix": "npm run format && npm run lint:eslint -- --fix",
		"dev:acceptance": "vite --host 127.0.0.1 --port 4173 --strictPort",
		"test:acceptance": "playwright test",
		"test:acceptance:ui": "playwright test --ui",
		"test:acceptance:headed": "playwright test --headed",
		"test:vitest": "vitest run",
		"test:vitest:watch": "vitest",
		"test:vitest:coverage": "vitest run --coverage",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit --pool=threads",
		"test:components": "vitest run tests/integration/components",
		"test:integration": "vitest run tests/integration",
		"test:security": "npm audit --audit-level=high",
		"test:all": "npm run test:unit && npm run test:components && npm run test:integration && npm run test:acceptance && npm run test:security",
		"test:precommit": "echo 'Running unit tests...' && npm run test:unit && echo 'Running format check and ESLint...' && npm run lint && echo 'Pre-commit checks passed.'"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true,
		"@sveltejs/adapter-auto@7.0.1": true,
		"fsevents@2.3.2": true
	},
	"dependencies": {
		"fomantic-ui-css": "^2.9.4",
		"node-gyp": "^13.0.1",
		"rebuild": "^1.0.2"
	}
}
