{
	"name": "tmdb-sveltekit-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "npm run format:check && npm run lint:eslint",
		"format": "prettier --write ./src",
		"format:check": "prettier --check ./src",
		"lint:eslint": "eslint ./src",
		"lint:fix": "npm run format && npm run lint:eslint -- --fix",
		"dev:acceptance": "vite --host 127.0.0.1 --port 4173 --strictPort",
		"test:acceptance": "playwright test tests/acceptance",
		"test:acceptance:ui": "playwright test --ui",
		"test:vitest": "vitest run",
		"test:vitest:watch": "vitest",
		"test:vitest:coverage": "vitest run --coverage",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit --pool=threads",
		"test:components": "vitest run tests/components",
		"test:integration": "vitest run tests/integration",
		"test:all": "npm run test:unit && npm run test:components && npm run test:integration && npm run test:acceptance"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.102.0",
		"svelte": "^5.56.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true,
		"@sveltejs/adapter-auto@7.0.1": true,
		"fsevents@2.3.2": true
	},
	"dependencies": {
		"fomantic-ui-css": "^2.9.4",
		"node-gyp": "^13.0.1",
		"rebuild": "^0.1.2"
	}
}
